---
import MilestoneNode from "./MilestoneNode.astro";

interface Milestone {
  year: number | string;
  yearNum: number;
  label: string;
  detail: string;
  position: "above" | "below";
}

interface Props {
  startYear: number;
  endYear: number;
  milestones: Milestone[];
}

const { startYear, endYear, milestones } = Astro.props;

const span = endYear - startYear;
const yearStep = span > 8 ? 2 : 1;

const years: number[] = [];
for (let y = startYear; y <= endYear; y += yearStep) {
  years.push(y);
}
if (years[years.length - 1] !== endYear) {
  years.push(endYear);
}

// Cluster handling: milestones sharing the same yearNum get alternating positions
const yearCounts = new Map<number, number>();
const processedMilestones = milestones.map((m) => {
  const count = yearCounts.get(m.yearNum) ?? 0;
  yearCounts.set(m.yearNum, count + 1);
  return { ...m, pct: ((m.yearNum - startYear) / span) * 100 };
});

const yearIndices = new Map<number, number>();
for (const m of processedMilestones) {
  const total = yearCounts.get(m.yearNum) ?? 1;
  if (total > 1) {
    const idx = yearIndices.get(m.yearNum) ?? 0;
    m.position = idx % 2 === 0 ? "above" : "below";
    yearIndices.set(m.yearNum, idx + 1);
  }
}

// Collision detection: nudge overlapping milestones apart horizontally
const MIN_GAP = 5; // minimum % distance between dots
processedMilestones.sort((a, b) => a.pct - b.pct);
for (let i = 1; i < processedMilestones.length; i++) {
  const prev = processedMilestones[i - 1];
  const curr = processedMilestones[i];
  const gap = curr.pct - prev.pct;
  if (gap < MIN_GAP) {
    const shift = (MIN_GAP - gap) / 2;
    prev.pct = Math.max(0, prev.pct - shift);
    curr.pct = Math.min(100, curr.pct + shift);
    // Cascade: re-check previous pair if we pushed prev back
    if (i > 1) i -= 2;
  }
}
---

<div class="relative h-40">
  <!-- Horizontal line -->
  <div class="absolute left-0 right-0 top-1/2 h-0.5 bg-white/15"></div>

  <!-- Year markers -->
  {
    years.map((year) => {
      const pct = ((year - startYear) / span) * 100;
      return (
        <div class="absolute top-1/2 -translate-x-1/2" style={`left: ${pct}%`}>
          <div class="h-2 w-px bg-white/10" />
          <span class="absolute top-3 left-1/2 -translate-x-1/2 text-[10px] text-muted/60 whitespace-nowrap">
            {year}
          </span>
        </div>
      );
    })
  }

  <!-- Milestone nodes -->
  {
    processedMilestones.map((m) => (
      <div
        class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2"
        style={`left: ${m.pct}%`}
      >
        <MilestoneNode
          year={m.year}
          label={m.label}
          detail={m.detail}
          position={m.position}
        />
      </div>
    ))
  }
</div>

<!-- Fixed-position tooltip (managed by JS) -->
<div
  id="timeline-tooltip"
  class="pointer-events-none fixed z-[100] hidden w-48 rounded-lg border border-white/10 bg-[#0a0a0f] p-3 text-sm shadow-2xl transition-opacity duration-150"
>
  <p class="font-semibold text-accent" data-tt-year></p>
  <p class="text-foreground font-medium" data-tt-label></p>
  <p class="mt-1 text-muted text-xs" data-tt-detail></p>
</div>

<script>
  const tooltip = document.getElementById("timeline-tooltip");
  const nodes = document.querySelectorAll(".milestone-node");

  function showTooltip(e: Event) {
    const node = (e.currentTarget as HTMLElement);
    const year = node.dataset.tooltipYear ?? "";
    const label = node.dataset.tooltipLabel ?? "";
    const detail = node.dataset.tooltipDetail ?? "";

    if (!tooltip) return;

    tooltip.querySelector("[data-tt-year]")!.textContent = year;
    tooltip.querySelector("[data-tt-label]")!.textContent = label;
    tooltip.querySelector("[data-tt-detail]")!.textContent = detail;

    const rect = node.getBoundingClientRect();
    const ttWidth = 192; // w-48

    let left = rect.left + rect.width / 2 - ttWidth / 2;
    // Keep within viewport
    left = Math.max(8, Math.min(left, window.innerWidth - ttWidth - 8));

    tooltip.style.left = `${left}px`;
    tooltip.style.top = `${rect.top - 8}px`;
    tooltip.style.transform = "translateY(-100%)";
    tooltip.classList.remove("hidden");
    tooltip.style.opacity = "1";
  }

  function hideTooltip() {
    if (!tooltip) return;
    tooltip.style.opacity = "0";
    setTimeout(() => tooltip.classList.add("hidden"), 150);
  }

  nodes.forEach((node) => {
    node.addEventListener("mouseenter", showTooltip);
    node.addEventListener("mouseleave", hideTooltip);
    node.addEventListener("focus", showTooltip);
    node.addEventListener("blur", hideTooltip);
  });
</script>
