---
import MilestoneNode from "./MilestoneNode.astro";

interface Milestone {
  year: number | string;
  yearNum: number;
  label: string;
  detail: string;
  position: "above" | "below";
}

interface Props {
  startYear: number;
  endYear: number;
  milestones: Milestone[];
}

const { startYear, endYear, milestones } = Astro.props;

const span = endYear - startYear;
const yearStep = span > 8 ? 2 : 1;

const years: number[] = [];
for (let y = startYear; y <= endYear; y += yearStep) {
  years.push(y);
}
// Always include endYear if not already present
if (years[years.length - 1] !== endYear) {
  years.push(endYear);
}

// Cluster handling: milestones sharing the same yearNum get alternating positions
const yearCounts = new Map<number, number>();
const processedMilestones = milestones.map((m) => {
  const count = yearCounts.get(m.yearNum) ?? 0;
  yearCounts.set(m.yearNum, count + 1);
  return { ...m };
});

// Second pass: enforce alternating for clustered milestones
const yearIndices = new Map<number, number>();
for (const m of processedMilestones) {
  const total = yearCounts.get(m.yearNum) ?? 1;
  if (total > 1) {
    const idx = yearIndices.get(m.yearNum) ?? 0;
    m.position = idx % 2 === 0 ? "above" : "below";
    yearIndices.set(m.yearNum, idx + 1);
  }
}
---

<div
  class="relative overflow-x-auto scroll-smooth [-webkit-overflow-scrolling:touch] [scroll-snap-type:x_mandatory]"
>
  <div class="min-w-[600px] relative py-16 px-8 mx-auto">
    <!-- Horizontal line -->
    <div class="absolute left-8 right-8 top-1/2 h-0.5 bg-white/15"></div>

    <!-- Year markers -->
    <div class="absolute left-8 right-8 top-1/2">
      {
        years.map((year) => {
          const pct = ((year - startYear) / span) * 100;
          return (
            <div class="absolute -translate-x-1/2" style={`left: ${pct}%`}>
              <div class="h-2 w-px bg-white/10" />
              <span class="absolute top-full mt-1 left-1/2 -translate-x-1/2 text-[10px] text-muted/60 whitespace-nowrap">
                {year}
              </span>
            </div>
          );
        })
      }
    </div>

    <!-- Milestone nodes -->
    <div class="absolute left-8 right-8 top-1/2">
      {
        processedMilestones.map((m, i) => {
          const pct = ((m.yearNum - startYear) / span) * 100;
          const isFirst = i === 0;
          const isLast = i === processedMilestones.length - 1;
          const edge = isFirst ? "left" : isLast ? "right" : undefined;
          return (
            <div
              class="absolute -translate-x-1/2 -translate-y-1/2"
              style={`left: ${pct}%`}
            >
              <MilestoneNode
                year={m.year}
                label={m.label}
                detail={m.detail}
                position={m.position}
                edge={edge}
              />
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<p class="mt-2 text-center text-xs text-muted md:hidden">
  Swipe to explore timeline &rarr;
</p>
