---
interface Props {
  year: number | string;
  label: string;
  detail: string;
  position?: "above" | "below";
}

const { year, label, detail, position = "above" } = Astro.props;

const isAbove = position === "above";
const labelClasses = isAbove ? "bottom-full mb-3" : "top-full mt-3";
---

<div
  class="milestone-node relative flex flex-col items-center cursor-pointer"
  tabindex="0"
  data-tooltip-year={String(year)}
  data-tooltip-label={label}
  data-tooltip-detail={detail}
>
  <!-- Milestone dot -->
  <div
    class="size-3 rounded-full bg-accent border-2 border-background transition-transform duration-200 hover:scale-150 focus:scale-150"
  >
  </div>

  <!-- Short label (always visible) -->
  <span
    class:list={[
      "absolute text-[10px] leading-tight text-muted whitespace-nowrap max-w-[80px] text-center overflow-hidden text-ellipsis pointer-events-none",
      labelClasses,
    ]}
  >
    {label}
  </span>
</div>
