---
import SectionHeader from "../SectionHeader.astro";

const testimonials = [
  {
    quote: "He pushed the team to own problems end-to-end — from architecture through monitoring and incident response — and gave people the space and trust to grow into bigger roles.",
    name: "Benjamin Sherry",
    title: "VP of Operations, Spark::red & Pivotree",
    relationship: "Reported to Russell for nearly a decade",
  },
  {
    quote: "He is equally liked and respected by his seniors and team. For me as my architect, he was fun to work with and I got to learn a lot.",
    name: "Ravi Ranjan",
    title: "VP Technology",
    relationship: "Colleague and mentee",
  },
  {
    quote: "One of the coolest and brightest people I have met in senior positions. Both technically and in management skills.",
    name: "Jagadish Venati",
    title: "Senior Architect",
    relationship: "Colleague",
  },
];
---

<section class="py-16">
  <div class="mx-auto max-w-4xl px-6">
    <h3 class="text-sm font-semibold uppercase tracking-widest text-accent">What People Say</h3>

    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <div class="rounded-lg border border-white/10 bg-white/5 p-6">
          <p class="text-sm leading-relaxed text-muted italic">"{t.quote}"</p>
          <div class="mt-4 border-t border-white/5 pt-4">
            <p class="text-sm font-medium text-foreground">{t.name}</p>
            <p class="text-xs text-muted">{t.title}</p>
            <p class="mt-0.5 text-xs text-accent">{t.relationship}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
