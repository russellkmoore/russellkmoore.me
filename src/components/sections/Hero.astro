---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import headshot from "../../assets/headshot.jpeg";
import Card from "../Card.astro";
---

<section class="relative flex min-h-[65vh] items-center justify-center">
  <!-- Mesh gradient background -->
  <div class="hero-gradient" aria-hidden="true"></div>
  <!-- Bottom fade to blend into next section -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-linear-to-b from-transparent to-background" aria-hidden="true"></div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-4xl px-6 py-24">
    <!-- Headshot + narrative -->
    <div class="flex flex-col items-start gap-8 md:flex-row md:items-center">
      <Image
        src={headshot}
        alt="Russell Moore"
        width={160}
        height={160}
        class="size-40 shrink-0 rounded-full object-cover ring-2 ring-white/10"
      />
      <div>
        <h1 class="text-4xl font-bold tracking-tight text-foreground md:text-5xl">
          Russell Moore
        </h1>
        <p class="mt-2 text-lg font-medium text-accent">
          Technology Executive | VP Engineering & AI Strategy
        </p>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
          I've spent twenty years leading engineering organizations that build and
          operate at enterprise scale — from architecting AT&T's $2B+ commerce
          platform to co-founding Spark::red and scaling it to $13M ARR. I led that
          business through acquisition by Pivotree, then ran the combined $30M
          division as SVP through IPO preparation. Along the way, I've managed 200+
          engineers across three continents, navigated M&A integration, and learned
          that the best technical leaders don't stop building. I'm also a U.S. Army
          Intelligence veteran and Distinguished Graduate of the Defense Language
          Institute — a background that shaped how I lead long before I entered tech.
        </p>
      </div>
    </div>

    <!-- Stats cards -->
    <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4">
      <Card>
        <p class="text-4xl font-bold text-accent">20+</p>
        <p class="mt-1 text-sm text-muted">Years Experience</p>
      </Card>
      <Card>
        <p class="text-4xl font-bold text-accent">$2B+</p>
        <p class="mt-1 text-sm text-muted">Platform Scale</p>
      </Card>
      <Card>
        <p class="text-4xl font-bold text-accent">$13M</p>
        <p class="mt-1 text-sm text-muted">ARR Built & Acquired</p>
      </Card>
      <Card>
        <p class="text-4xl font-bold text-accent">200+</p>
        <p class="mt-1 text-sm text-muted">Global Team</p>
      </Card>
    </div>

    <!-- CTA links below stats -->
    <div class="mt-10 flex items-center justify-center gap-8">
      <a
        href="#projects"
        class="group inline-flex items-center gap-2 text-foreground transition-colors hover:text-accent"
      >
        Latest Projects
        <Icon
          name="lucide:arrow-right"
          class="size-4 transition-transform group-hover:translate-x-1"
        />
      </a>
      <a
        href="#contact"
        class="group inline-flex items-center gap-2 text-muted transition-colors hover:text-foreground"
      >
        Let's Talk
        <Icon
          name="lucide:arrow-right"
          class="size-4 transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .hero-gradient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .hero-gradient::before,
  .hero-gradient::after {
    content: "";
    position: absolute;
    inset: -50%;
    will-change: transform;
  }

  .hero-gradient::before {
    background:
      radial-gradient(
        circle 500px at 30% 40%,
        rgba(167, 100, 255, 0.4) 0%,
        rgba(124, 58, 237, 0.15) 50%,
        transparent 80%
      ),
      radial-gradient(
        circle 400px at 75% 60%,
        rgba(96, 165, 250, 0.3) 0%,
        rgba(59, 130, 246, 0.1) 50%,
        transparent 80%
      );
    animation: meshMove1 8s ease-in-out infinite alternate;
  }

  .hero-gradient::after {
    background:
      radial-gradient(
        circle 450px at 65% 25%,
        rgba(192, 132, 252, 0.3) 0%,
        rgba(139, 92, 246, 0.08) 50%,
        transparent 75%
      ),
      radial-gradient(
        circle 350px at 30% 75%,
        rgba(96, 165, 250, 0.25) 0%,
        rgba(59, 130, 246, 0.06) 50%,
        transparent 75%
      );
    animation: meshMove2 12s ease-in-out infinite alternate-reverse;
  }

  @keyframes meshMove1 {
    0% {
      transform: translate(0, 0) scale(1) rotate(0deg);
    }
    50% {
      transform: translate(8%, -6%) scale(1.08) rotate(2deg);
    }
    100% {
      transform: translate(-5%, 4%) scale(0.95) rotate(-1deg);
    }
  }

  @keyframes meshMove2 {
    0% {
      transform: translate(0, 0) scale(1) rotate(0deg);
    }
    50% {
      transform: translate(-6%, 5%) scale(1.05) rotate(-2deg);
    }
    100% {
      transform: translate(4%, -3%) scale(0.97) rotate(1deg);
    }
  }
</style>
