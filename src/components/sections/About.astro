---
import Card from "../Card.astro";
import SectionHeader from "../SectionHeader.astro";
---

<section id="about" class="py-24">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeader title="About" />

    <!-- Narrative paragraph (D-17: first-person, direct) -->
    <p class="max-w-3xl text-lg leading-relaxed text-muted">
      I build AI-powered products and lead engineering teams that ship at scale.
      Over two decades, I've taken platforms from zero to $2B+ in transaction
      volume, built and acquired $13M in ARR, and led distributed teams of 200+
      engineers across three continents. Today, I'm focused on the intersection
      of AI and commerce — building tools that make complex systems intelligent
      and accessible.
    </p>

    <!-- Stats cards (D-10: 4 cards in a row) -->
    <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4">
      <Card>
        <p class="text-3xl font-semibold text-foreground">20+</p>
        <p class="mt-1 text-sm text-muted">Years Experience</p>
      </Card>
      <Card>
        <p class="text-3xl font-semibold text-foreground">$2B+</p>
        <p class="mt-1 text-sm text-muted">Platform Scale</p>
      </Card>
      <Card>
        <p class="text-3xl font-semibold text-foreground">$13M</p>
        <p class="mt-1 text-sm text-muted">ARR Built & Acquired</p>
      </Card>
      <Card>
        <p class="text-3xl font-semibold text-foreground">200+</p>
        <p class="mt-1 text-sm text-muted">Global Team</p>
      </Card>
    </div>
  </div>
</section>
