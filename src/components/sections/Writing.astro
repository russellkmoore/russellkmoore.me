---
import { getCollection } from "astro:content";
import PostCard from "../PostCard.astro";
import SectionHeader from "../SectionHeader.astro";

// Draft entries never render -- filter them out at query time
const publishedWriting = await getCollection("writing", ({ data }) => !data.draft);
const latestPosts = publishedWriting
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<section id="writing" class="py-24">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeader title="Writing" subtitle="Thoughts on building" />

    {latestPosts.length > 0 ? (
      <>
        <div class="grid gap-6 md:grid-cols-3">
          {latestPosts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              href={"/writing/" + post.id}
            />
          ))}
        </div>
        <a
          href="/writing"
          class="mt-8 inline-flex items-center gap-1 text-sm text-accent transition-colors hover:text-accent-hover"
        >
          View all writing <span aria-hidden="true">&rarr;</span>
        </a>
      </>
    ) : (
      <p class="text-lg text-muted">Coming soon.</p>
    )}
  </div>
</section>
