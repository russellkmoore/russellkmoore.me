---
import { getCollection } from "astro:content";
import Card from "../Card.astro";
import SectionHeader from "../SectionHeader.astro";

// Draft entries never render -- filter them out at query time
const publishedWriting = await getCollection("writing", ({ data }) => !data.draft);
---

<section id="writing" class="py-24">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeader title="Writing" subtitle="Thoughts on building" />

    {publishedWriting.length > 0 ? (
      <div class="grid gap-6 md:grid-cols-2">
        {publishedWriting.map((post) => (
          <Card>
            <h3 class="font-semibold text-foreground">{post.data.title}</h3>
            <p class="mt-2 text-sm text-muted">{post.data.description}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="text-xs text-muted">{tag}</span>
              ))}
            </div>
          </Card>
        ))}
      </div>
    ) : (
      <p class="text-lg text-muted">Coming soon.</p>
    )}
  </div>
</section>
