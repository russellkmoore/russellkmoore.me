---
import SectionHeader from "../SectionHeader.astro";
---

<section id="career" class="py-24">
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeader title="Career" subtitle="Where I've made impact" />

    <div class="relative ml-4 space-y-12 border-l-2 border-white/10 pl-8">
      <!-- AT&T -->
      <div class="relative">
        <div class="absolute -left-[calc(2rem+9px)] top-1 size-4 rounded-full border-2 border-accent bg-background"></div>
        <h3 class="text-lg font-semibold text-foreground">AT&T</h3>
        <p class="text-sm text-accent">Sr. Director, Engineering</p>
        <ul class="mt-3 space-y-1 text-sm text-muted">
          <li>Led a platform serving $2B+ in annual transaction volume</li>
          <li>Managed 200+ engineers across distributed global teams</li>
          <li>Drove architecture modernization from monolith to composable microservices</li>
        </ul>
      </div>

      <!-- Spark::red -->
      <div class="relative">
        <div class="absolute -left-[calc(2rem+9px)] top-1 size-4 rounded-full border-2 border-accent bg-background"></div>
        <h3 class="text-lg font-semibold text-foreground">Spark::red</h3>
        <p class="text-sm text-accent">Co-founder and CTO</p>
        <ul class="mt-3 space-y-1 text-sm text-muted">
          <li>Co-founded and built an AI-powered product from zero to acquisition</li>
          <li>Scaled ARR to $3M before successful exit</li>
          <li>Hands-on technical leadership across full stack and ML pipeline</li>
        </ul>
      </div>

      <!-- Pivotree -->
      <div class="relative">
        <div class="absolute -left-[calc(2rem+9px)] top-1 size-4 rounded-full border-2 border-accent bg-background"></div>
        <h3 class="text-lg font-semibold text-foreground">Pivotree</h3>
        <p class="text-sm text-accent">VP, Engineering and Technology</p>
        <ul class="mt-3 space-y-1 text-sm text-muted">
          <li>Built and acquired $13M in ARR through organic growth and strategic M&A</li>
          <li>Led digital commerce practice serving Fortune 500 clients</li>
          <li>Established engineering centers of excellence across 3 continents</li>
        </ul>
      </div>
    </div>
  </div>
</section>
