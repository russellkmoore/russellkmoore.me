---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Card from "../Card.astro";
import Badge from "../Badge.astro";
import SectionHeader from "../SectionHeader.astro";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
const featured = sortedProjects.filter((p) => p.data.featured);
const other = sortedProjects.filter((p) => !p.data.featured);

---

<section id="projects" class="py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeader title="Projects" subtitle="What I'm building" />

    <!-- Featured projects: larger cards -->
    <div class="featured-projects">
      {featured.map((project) => (
        <div class="relative cursor-pointer project-card" data-href={`/projects/${project.id}`}>
        <Card variant="featured">
          <div class="flex items-start justify-between">
            <h3 class="text-xl font-semibold text-foreground">{project.data.title}</h3>
            <Badge variant="status">{project.data.status}</Badge>
          </div>
          <p class="mt-3 text-muted">{project.data.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {project.data.stack.map((tech) => (
              <Badge variant="tech">{tech}</Badge>
            ))}
          </div>
          <div class="mt-4 flex items-center gap-4">
            {project.data.url && (
              <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="relative z-10 inline-flex items-center gap-1 text-sm text-accent hover:text-accent-hover transition-colors">
                Visit project
              </a>
            )}
            {project.data.github && (
              <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="relative z-10 inline-flex items-center gap-1.5 text-sm text-muted hover:text-foreground transition-colors" aria-label={`${project.data.title} on GitHub`}>
                <Icon name="lucide:github" class="size-4" />
                Source
              </a>
            )}
          </div>
          <a href={`/projects/${project.id}`} class="mt-4 inline-flex items-center gap-1 text-sm text-accent">
            View project <span aria-hidden="true">&rarr;</span>
          </a>
        </Card>
        </div>
      ))}
    </div>

    <!-- Non-featured projects: compact cards -->
    {other.length > 0 && (
      <div class="mt-8 space-y-4">
        {other.map((project) => (
          <div class="cursor-pointer project-card" data-href={`/projects/${project.id}`}>
            <Card>
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="font-semibold text-foreground">{project.data.title}</h3>
                  <p class="mt-1 text-sm text-muted">{project.data.description}</p>
                </div>
                <Badge variant="status">{project.data.status}</Badge>
              </div>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                {project.data.stack.map((tech) => (
                  <Badge variant="tech">{tech}</Badge>
                ))}
                <div class="ml-auto flex items-center gap-3">
                  {project.data.url && (
                    <a href={project.data.url} target="_blank" rel="noopener noreferrer" class="relative z-10 inline-flex items-center gap-1 text-sm text-accent hover:text-accent-hover transition-colors">
                      <Icon name="lucide:external-link" class="size-3.5" />
                    </a>
                  )}
                  {project.data.github && (
                    <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="relative z-10 inline-flex items-center gap-1.5 text-sm text-muted hover:text-foreground transition-colors" aria-label={`${project.data.title} on GitHub`}>
                      <Icon name="lucide:github" class="size-4" />
                    </a>
                  )}
                  <a href={`/projects/${project.id}`} class="inline-flex items-center gap-1 text-sm text-accent">
                    View project <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            </Card>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<style is:inline>
  .featured-projects {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .featured-projects {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll(".project-card").forEach((card) => {
    card.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      const href = (card as HTMLElement).dataset.href;
      if (href) window.location.href = href;
    });
  });
</script>
