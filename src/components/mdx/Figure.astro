---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  width?: string;
  bordered?: boolean;
  shadow?: boolean;
}

const { src, alt, caption, width, bordered = false, shadow = false } = Astro.props;

const imgAlt = alt ?? caption ?? "";
---

<figure class="my-6" style={width ? `max-width: ${width}` : undefined}>
  <img
    src={src}
    alt={imgAlt}
    loading="lazy"
    class:list={[
      "w-full",
      bordered && "rounded-lg border border-white/10",
      shadow && "shadow-lg shadow-black/20",
    ]}
  />
  {caption && (
    <figcaption class="mt-2 text-center text-sm text-muted">
      {caption}
    </figcaption>
  )}
</figure>
