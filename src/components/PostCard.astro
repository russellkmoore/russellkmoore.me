---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  href: string;
}

const { title, description, pubDate, tags, href } = Astro.props;
const formattedDate = new Date(pubDate).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<a
  href={href}
  class="group block rounded-lg border border-white/10 bg-white/5 p-6 transition-colors hover:border-accent/30 hover:bg-white/[0.07]"
>
  <time datetime={new Date(pubDate).toISOString()} class="text-sm text-muted">
    {formattedDate}
  </time>
  <h3 class="mt-2 text-lg font-semibold text-foreground">
    {title}
  </h3>
  <p class="mt-2 line-clamp-2 text-sm text-muted">
    {description}
  </p>
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="inline-flex items-center rounded bg-accent/20 px-2 py-0.5 text-xs font-medium text-accent">
          {tag}
        </span>
      ))}
    </div>
  )}
  <span class="mt-4 inline-flex items-center gap-1 text-sm text-accent">
    Read more <span aria-hidden="true">&rarr;</span>
  </span>
</a>
