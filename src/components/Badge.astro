---
interface Props {
  variant?: "tech" | "status";
  class?: string;
}

const { variant = "tech", class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded px-2 py-0.5 text-xs font-medium",
    {
      "bg-accent/20 text-accent": variant === "tech",
      "bg-emerald-500/20 text-emerald-400": variant === "status",
    },
    className,
  ]}
>
  <slot />
</span>
