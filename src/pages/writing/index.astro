---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";

const publishedPosts = await getCollection("writing", ({ data }) => !data.draft);
const sortedPosts = publishedPosts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<Layout
  title="Writing | Russell Moore"
  description="Articles on engineering leadership, AI architecture, and building products"
>
  <section class="py-24">
    <div class="mx-auto max-w-4xl px-6">
      <SectionHeader title="Writing" subtitle="Thoughts on building" />

      {sortedPosts.length > 0 ? (
        <div class="flex flex-col gap-6">
          {sortedPosts.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              href={"/writing/" + post.id}
            />
          ))}
        </div>
      ) : (
        <p class="text-lg text-muted">Coming soon.</p>
      )}
    </div>
  </section>
</Layout>
